# Server Configuration
PORT=5000

# MongoDB Connection String (Replace <username> and <password> with your MongoDB Atlas credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostel_db?retryWrites=true&w=majority

# JWT Secret Key for Admin Authentication
JWT_SECRET=your_jwt_secret_key_here

# Default Admin Portal Credentials
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=admin123
